---
import { FAQAccordion } from "./FAQAccordion";
import styles from "./index.module.scss";

const FAQS = [
  {
    q: "Как долго будет храниться страница памяти?",
    a: "Страницы памяти хранятся бессрочно. Мы поддерживаем специальный фонд долгосрочного хранения, который обеспечивает доступ к мемориалам независимо от выбранного тарифа.",
  },
  {
    q: "Кто сможет просматривать страницу?",
    a: "Вы можете сделать страницу публичной, доступной только по приглашению или полностью приватной.",
  },
  {
    q: "Как работает QR-код?",
    a: "QR-код можно разместить на памятнике. При сканировании открывается страница памяти с фотографиями, биографией и другими материалами.",
  },
  {
    q: "Можно ли управлять страницей всей семьёй?",
    a: "Да. В расширенных тарифах можно добавить нескольких редакторов, которые смогут обновлять информацию.",
  },
  {
    q: "Что произойдёт после окончания платного тарифа?",
    a: "Страница останется доступной, но часть дополнительных функций станет недоступна.",
  },
  {
    q: "Работает ли сервис за пределами России?",
    a: "Да, страницы памяти доступны по всему миру.",
  },
];
---

<section id="faq" class={styles.faq_section}>
  <div class={styles.faq_container}>
    <div class={styles.faq_heading}>
      <p class={styles.faq_subtitle}>Частые вопросы</p>
      <h2 class={styles.faq_title}>Ответы на популярные вопросы</h2>
    </div>

    <FAQAccordion client:load faqs={FAQS} />
  </div>
</section>
